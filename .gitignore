# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It holds no secrets — only the NAMES of the variables
# and where to get each one — and it is useless if it never reaches the person
# setting up the project. It was silently swallowed by the blanket rule above,
# so the Stripe and Resend setup notes existed only on one laptop.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
