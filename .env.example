# DataRev — Diagnóstico de madurez. Copy to .env.local and fill in.
# All four are public by design: writes go through SECURITY DEFINER functions
# (capture_lead / request_consultation), so no secret key is needed anywhere.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

NEXT_PUBLIC_CALENDLY_GUIDED_URL=https://calendly.com/admin-datarev/60min-diagnostico
NEXT_PUBLIC_CALENDLY_REVIEW_URL=https://calendly.com/admin-datarev/30min

# --- Transactional email (Resend) -------------------------------------------
# Optional. With both unset the app still captures leads normally; it simply
# sends no confirmation email and logs one warning per process. Nothing 500s.
#
# DOMAIN VERIFICATION IS REQUIRED. A fresh Resend account can only send to the
# address that owns the account — every other recipient is rejected with a 422
# until you add datarev.solutions under Domains, publish the SPF/DKIM records
# it gives you, and wait for the status to turn Verified. Until then leads will
# NOT receive anything, even with a valid key.
#
# EMAIL_FROM must be an address on that verified domain. Anything else is
# refused by the API, not silently dropped.
RESEND_API_KEY=re_...
EMAIL_FROM=DataRev <diagnostico@datarev.solutions>

# Absolute base URL. Shared with the Stripe checkout/portal redirects; email
# links use it too, since a relative path is meaningless in an inbox. Falls
# back to https://datarev.solutions when unset.
NEXT_PUBLIC_SITE_URL=https://datarev.solutions

# --- Payments (Stripe) ------------------------------------------------------
# Optional. With these unset the pricing page still shows the advertised prices
# but renders no buy button, and the checkout route answers 503. Nothing 500s.
#
# The three price ids must be ONE-TIME prices denominated in USD. The checkout
# route rejects any other currency on purpose, so nobody is ever charged in a
# currency they did not expect. Create them in Stripe → Products; see
# docs/configurar-pagos.md for the amounts.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_DIAGNOSTIC=price_...
STRIPE_PRICE_PLAN=price_...
STRIPE_PRICE_GUIDED=price_...

# From Stripe → Developers → Webhooks, after adding the endpoint
# /api/stripe/webhook subscribed to checkout.session.completed. Without it the
# webhook rejects every delivery: a customer could pay and receive nothing.
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase → Settings → API. The ONLY key that can write a subscription row,
# because `subscriptions` has no insert policy at all. Server-side only — it
# must never appear in a NEXT_PUBLIC_ variable, in the browser, or in git.
SUPABASE_SERVICE_ROLE_KEY=
